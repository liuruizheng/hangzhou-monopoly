{
  "name": "hz-monopoly",
  "version": "1.0.0",
  "description": "杭州大富翁",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.hzmonopoly.app",
    "productName": "杭州大富翁",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": null,
      "uninstallerIcon": null,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "杭州大富翁_Setup_${version}.${ext}"
    },
    "files": [
      "index.html",
      "vue.global.js",
      "electron-main.js",
      "node_modules/**/*"
    ],
    "asar": false
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
